# Copy to .env.local and fill in.
#
# Note the absence of NEXT_PUBLIC_: all Supabase access is server-side, so
# nothing here reaches the browser. Adding the prefix would leak the endpoint
# into the client bundle without enabling anything.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Write access, bypasses RLS. Required only by `npm run seed:content`.
# Leave unset for normal development and deployment.
SUPABASE_SERVICE_ROLE_KEY=
